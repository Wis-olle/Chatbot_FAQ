# Điền key lấy tại https://aistudio.google.com/apikey vào file .env (không gửi key vào chat).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# CHAT_MODE=retrieval: trả lời từ nguồn SQLite, không gọi Gemini.
# Khi chưa có key, server tự dùng retrieval. mock là alias tương thích cho retrieval.
CHAT_MODE=gemini
